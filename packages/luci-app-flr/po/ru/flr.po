msgstr "международное имя не в punycode (xn--…)"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:70
msgid "invalid characters in domain"
msgstr "недопустимые символы в домене"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:71
msgid "FLR does not block destinations; they follow the other lists (unlisted: VPN)"
msgstr "FLR не блокирует назначения: они следуют остальным спискам (не указанные — через VPN)"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:72
msgid "FLR resolves every name through its own DNS broker; static host entries are not imported"
msgstr "FLR разрешает все имена своим DNS-брокером; статические записи хостов не импортируются"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:73
msgid "FLR uses its own resolvers: DoH inside the VPN, and the direct resolver of its settings for direct names"
msgstr "FLR использует свои резолверы: DoH внутри VPN и резолвер напрямую из своих настроек для имён напрямую"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:74
msgid "FLR does not use fake DNS answers"
msgstr "FLR не использует поддельные ответы DNS"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:75
msgid "FLR always matches the name first and, for unlisted names, the resolved IPv4 address (the same as IPIfNonMatch)"
msgstr "FLR всегда сначала сверяет имя, а для имён вне списков — полученный IPv4-адрес (как IPIfNonMatch)"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:76
msgid "FLR always gives the VPN lists precedence over the direct lists (block-proxy-direct)"
msgstr "у FLR списки VPN всегда важнее списков напрямую (block-proxy-direct)"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:77
msgid "FLR still sends unlisted destinations through the VPN"
msgstr "FLR по-прежнему отправляет назначения вне списков через VPN"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:78
msgid "%s bare entries were imported as substring (keyword) matches, as Xray matches them; write domain:example.com for a domain and its subdomains"
msgstr "Записей без префикса: %s; они импортированы как совпадение по подстроке (keyword), как их понимает Xray. Для домена с поддоменами пишите domain:example.com"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:79
msgid "an address in ProxyIp goes through the VPN even when its name is in DirectSites (FLR matches address sets before name-derived direct sets)"
msgstr "адрес из ProxyIp идёт через VPN, даже если его имя есть в DirectSites (FLR сверяет наборы адресов раньше наборов напрямую, полученных из имён)"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:80
msgid "DirectSites and DirectIp apply in routing mode split only; full_domestic and full ignore them"
msgstr "DirectSites и DirectIp действуют только в режиме маршрутизации split; full_domestic и full их не используют"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:81
msgid "%s repeated category references were expanded once"
msgstr "Повторных ссылок на категории: %s; каждая развёрнута один раз"

#: htdocs/luci-static/resources/view/flr/routing/transfer.js:82
msgid "attribute filters follow Xray: geosite:name@attr keeps domains with the attribute key attr; a leading ! is part of the key"
msgstr "фильтры атрибутов как в Xray: geosite:name@attr оставляет домены с ключом атрибута attr; начальный ! — часть ключа"
