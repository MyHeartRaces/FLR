#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
 # The native locked primitive understands generation/deadline and legacy
 # tokens. Failure keeps the pending marker and must never start VPN.
 recovery="$(/usr/sbin/flr-controller rollback-token recover)" || return $?
 if [ "$recovery" = recovered ]; then
  disable
  return $?
 fi
 # Clean images run administration/direct with VPN disabled safe defaults.
 procd_open_instance
 procd_set_param command /usr/sbin/flr-controller run
 procd_set_param respawn 30 5 0
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
 # Optional engine updater: exists only when the owner created its config.
 # The loop exits 0 when the config says disabled; the long respawn delay
 # keeps that cheap. It never signals or restarts any engine process.
 if [ -f /etc/flr-runtime/engine-update.json ]; then
  procd_open_instance engine_update
  procd_set_param command /usr/sbin/flr-controller engine loop
  procd_set_param respawn 3600 300 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
 fi
}
