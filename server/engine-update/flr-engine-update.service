[Unit]
Description=FLR engine auto-updater (Hysteria2 compatibility lock)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/flr-engine-update run
TimeoutStartSec=45min
Nice=10
# Hardening. Root is needed for systemctl restart; everything else is read-only.
ProtectSystem=strict
# The canary child inherits this sandbox. It needs: UDP/TCP sockets (AF_INET/AF_INET6),
# AF_NETLINK (Go interface lookups), read access to the TLS cert/key files and to
# server.yaml outside /home. If the Hysteria YAML uses `acme:` with a writable dir,
# add that directory to ReadWritePaths.
ReadWritePaths=/var/lib/flr-engine /usr/local/bin
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
# Not ProtectKernelModules: it hides /lib/modules, and the kernel gate must
# read it to tell whether the newest kernel has an AmneziaWG module. Loading
# modules stays impossible without CAP_SYS_MODULE.
CapabilityBoundingSet=~CAP_SYS_MODULE
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
