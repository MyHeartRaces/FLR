            "hashes_asset": "hashes.txt",
            "binary": "/usr/local/bin/hysteria",
            "unit": "flint-hysteria",
            "config_path": "/etc/flint-vpn/hysteria/server.yaml",
            "canary_port": 40443,
            "canary_timeout_s": 20,
