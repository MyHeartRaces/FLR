EXIT_OK = 0
EXIT_ERROR = 1        # usage, config, I/O or unexpected error
EXIT_ROLLBACK = 2     # a version was blocked and/or rolled back during this run
EXIT_TRANSIENT = 3    # network or verification failure, no state change
EXIT_UNSAFE = 4       # gate: newest installed kernel has no AWG module
EXIT_BUSY = 5         # another run holds the lock

MAX_DOWNLOAD = 64 * 1024 * 1024
MAX_TEXT = 1024 * 1024
# GitHub release listings carry every asset and the release notes; Hysteria
# publishes ~40 assets per release, so one page exceeds MAX_TEXT.
MAX_JSON = 8 * 1024 * 1024
DOWNLOAD_DEADLINE_S = 900
